[Unit]
Description=Favilla daemon: lighting and settings for SteelSeries devices
Documentation=https://github.com/fontanamichele/favilla
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=@BINDIR@/favillad
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
